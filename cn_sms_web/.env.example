# CNSMS Environment Configuration
# Copy to .env and fill in values

# Flask
SECRET_KEY=your-very-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database (SQLite default, uncomment for PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost/cnsms

# AI Configuration
AI_MODE=mock
# Set to 'hf' to use Hugging Face API
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=hustvl/yolos-tiny

# File Uploads
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=1048576

# Password Reset
# Leave empty for dev mode (token returned in response)
# Set for production email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cnsms.edu

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=86400

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
