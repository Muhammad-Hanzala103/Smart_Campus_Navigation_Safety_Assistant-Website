{
    "User": {
        "columns": [
            {
                "name": "id",
                "type": "Integer",
                "constraints": "PK"
            },
            {
                "name": "full_name",
                "type": "String(100)",
                "constraints": "NOT NULL"
            },
            {
                "name": "email",
                "type": "String(120)",
                "constraints": "UNIQUE, NOT NULL"
            },
            {
                "name": "password_hash",
                "type": "String(128)",
                "constraints": "NOT NULL"
            },
            {
                "name": "role",
                "type": "String(20)",
                "constraints": "NOT NULL"
            },
            {
                "name": "department",
                "type": "String(100)",
                "constraints": "nullable"
            },
            {
                "name": "is_active",
                "type": "Boolean",
                "constraints": "Default=True"
            }
        ],
        "relationships": [
            "reported_incidents (Active Load)",
            "assigned_incidents (Active Load)"
        ],
        "example_row": {
            "id": 1,
            "full_name": "Admin User",
            "email": "admin@cnsms.com",
            "role": "admin",
            "is_active": true
        }
    },
    "Incident": {
        "columns": [
            {
                "name": "id",
                "type": "Integer",
                "constraints": "PK"
            },
            {
                "name": "user_id",
                "type": "Integer",
                "constraints": "FK(user.id)"
            },
            {
                "name": "description",
                "type": "Text",
                "constraints": "NOT NULL"
            },
            {
                "name": "status",
                "type": "String(20)",
                "constraints": "Default='new'"
            },
            {
                "name": "image_path",
                "type": "String(200)",
                "constraints": "nullable"
            },
            {
                "name": "ai_severity",
                "type": "String(20)",
                "constraints": "Default='LOW'"
            },
            {
                "name": "ai_risk_score",
                "type": "Integer",
                "constraints": "Default=0"
            },
            {
                "name": "ai_labels",
                "type": "Text",
                "constraints": "JSON String"
            }
        ],
        "relationships": [
            "reporter (Many-to-One)",
            "assigned_officer (Many-to-One)"
        ],
        "example_row": {
            "id": 101,
            "description": "Smoke detected in Lab 3",
            "status": "new",
            "ai_severity": "HIGH",
            "ai_risk_score": 95
        }
    },
    "AuditLog": {
        "columns": [
            {
                "name": "id",
                "type": "Integer",
                "constraints": "PK"
            },
            {
                "name": "user_id",
                "type": "Integer",
                "constraints": "FK(user.id)"
            },
            {
                "name": "action",
                "type": "String(100)",
                "constraints": "NOT NULL"
            },
            {
                "name": "details",
                "type": "String(500)",
                "constraints": "nullable"
            },
            {
                "name": "ip_address",
                "type": "String(45)",
                "constraints": "nullable"
            }
        ],
        "example_row": {
            "id": 505,
            "user_id": 1,
            "action": "LOGIN_SUCCESS",
            "ip_address": "127.0.0.1"
        }
    },
    "MapNode": {
        "columns": [
            {
                "name": "id",
                "type": "Integer",
                "constraints": "PK"
            },
            {
                "name": "name",
                "type": "String(50)",
                "constraints": "NOT NULL"
            },
            {
                "name": "x",
                "type": "Float",
                "constraints": "NOT NULL"
            },
            {
                "name": "y",
                "type": "Float",
                "constraints": "NOT NULL"
            }
        ],
        "example_row": {
            "id": 1,
            "name": "Main Entrance",
            "x": 10.5,
            "y": 20.0
        }
    }
}